# Copie para backend/.env e ajuste o que precisar. Tudo é opcional:
# sem nenhuma variável o Garimpo cria um SQLite em ~/.garimpo-ai/garimpo.db.

# Onde ficam banco, checkpoints das etapas e notebooks gerados.
# GARIMPO_HOME=~/.garimpo-ai

# Postgres em vez do SQLite (o banco precisa existir; as tabelas são criadas no start).
# GARIMPO_DATABASE_URL=postgresql+psycopg://garimpo:senha@localhost:5432/garimpo

# Restringe o navegador de arquivos a estes diretórios (recomendado fora do desktop).
# Vazio = qualquer caminho legível pelo processo.
# GARIMPO_ALLOWED_ROOTS=/home/usuario/dados,/mnt/datalake

# Origens liberadas no CORS (o `ng serve` roda em 4200).
# GARIMPO_CORS_ORIGINS=http://localhost:4200

# Limite de linhas lidas por fonte (0 = sem limite). Útil para bases enormes.
# GARIMPO_MAX_ROWS_PER_SOURCE=0

# Tentativas de auto-correção de código por etapa de agente.
# GARIMPO_MAX_RETRIES_PER_STEP=3
